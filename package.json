{
  "name": "ebt-gps-tracking",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "shared",
    "client"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate --config server/prisma7.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=server/.env --import tsx server/src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=server/.env --import tsx server/src/seed.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=server/.env --import tsx server/src/main.ts",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=server/.env --import tsx --watch server/src/main.ts",
    "simulate": "node --env-file-if-exists=.env --env-file-if-exists=server/.env --import tsx server/src/simulator.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @ebt/client",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=server/.env --import tsx --test server/test/api.test.ts client/test/*.test.ts",
    "device:rename": "node --env-file-if-exists=.env --env-file-if-exists=server/.env --import tsx server/src/rename-device.ts",
    "dev:client": "npm run dev --workspace @ebt/client",
    "build": "npm run build --workspace @ebt/client"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
