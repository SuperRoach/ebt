{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ebt:telemetry:v1",
  "title": "EBT telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "deviceId", "firmwareVersion", "recordingSessionId", "recordingState", "transport", "batteryVoltage", "samples"],
  "properties": {
    "version": {"const": 1},
    "deviceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "firmwareVersion": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"},
    "recordingSessionId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "recordingState": {"enum": ["idle", "recording", "paused", "stopped"]},
    "transport": {"enum": ["wifi", "4g"]},
    "cellularSignal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rssiDbm": {"type": "number", "minimum": -150, "maximum": 0},
        "rsrpDbm": {"type": "number", "minimum": -150, "maximum": 0},
        "rsrqDb": {"type": "number", "minimum": -50, "maximum": 0},
        "sinrDb": {"type": "number", "minimum": -50, "maximum": 100}
      },
      "minProperties": 1
    },
    "batteryVoltage": {"type": "number", "minimum": 0, "maximum": 30},
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/definitions/sample"}
    }
  },
  "definitions": {
    "sequence": {"type": "string", "pattern": "^[a-f0-9]{32}:[0-9]{10}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "timestamp", "latitude", "longitude", "speedMps", "headingDeg", "fixValid", "satelliteCount"],
      "properties": {
        "sequence": {"$ref": "#/definitions/sequence"},
        "timestamp": {"$ref": "#/definitions/timestamp"},
        "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "speedMps": {"type": ["number", "null"], "minimum": 0},
        "headingDeg": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360},
        "fixValid": {"type": "boolean"},
        "satelliteCount": {"type": "integer", "minimum": 0, "maximum": 255},
        "hdop": {"type": "number", "minimum": 0}
      },
      "if": {"properties": {"fixValid": {"const": true}}},
      "then": {
        "properties": {
          "latitude": {"type": "number"},
          "longitude": {"type": "number"},
          "speedMps": {"type": "number"},
          "headingDeg": {"type": "number"}
        }
      }
    }
  }
}
