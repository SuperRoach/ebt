# Optional target for Vite's local development and preview proxy.
EBT_PROXY_TARGET=http://127.0.0.1:3000

# VITE_* values are public in the browser bundle. Never put secrets here.
# These overrides are optional; the dashboard uses the same origin by default.
# VITE_API_BASE_URL=https://tracking.example.org
# VITE_WS_URL=wss://tracking.example.org/api/v1/ws
