# Relative SQLite paths are resolved from the repository root.
DATABASE_URL=file:./ebt.db
HOST=127.0.0.1
PORT=3000

# Generate each key separately with: openssl rand -hex 32
# Required for db:seed and simulate. Keep the keys distinct.
# EBT_01_API_KEY=
# EBT_02_API_KEY=

# Optional: use a separate random token to enable device and dashboard message editing.
# EBT_ADMIN_TOKEN=

# Optional: bind the upload-only listener to your LAN IPv4 address for hardware tests.
# TELEMETRY_HOST=
# TELEMETRY_PORT=3001

# Optional public text shown under Cart tracking until an admin saves or clears it.
# EBT_DASHBOARD_MESSAGE="Race starts at 10 am"

# Optional: allow the dashboard to call this API from a separate origin.
# EBT_DASHBOARD_ORIGIN=https://lps-ebt-tracking.netlify.app
