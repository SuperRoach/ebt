generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model DashboardMessage {
  id       Int    @id
  message  String
  revision Int
}

model Device {
  id          String      @id
  displayName String
  colour      String?
  apiKeyHash  String      @unique
  samples     GpsSample[]
  firmwareReleases FirmwareRelease[]
  firmwareAssignment FirmwareAssignment?
}

model GpsSample {
  deviceId           String
  device             Device   @relation(fields: [deviceId], references: [id])
  sequence           String
  captureHash        String
  timestamp          DateTime
  receivedAt         DateTime
  protocolVersion    Int
  firmwareVersion    String
  recordingSessionId String
  recordingState     String
  transport          String
  cellularRssiDbm    Float?
  cellularRsrpDbm    Float?
  cellularRsrqDb     Float?
  cellularSinrDb     Float?
  batteryVoltage     Float
  latitude           Float?
  longitude          Float?
  speedMps           Float?
  headingDeg         Float?
  fixValid           Boolean
  satelliteCount     Int
  hdop               Float?

  @@id([deviceId, sequence])
  @@index([deviceId, timestamp, sequence])
}

model FirmwareRelease {
  id             String   @id
  targetDeviceId String
  targetDevice   Device   @relation(fields: [targetDeviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  version        String
  sha256         String
  sizeBytes      Int
  createdAt      DateTime @default(now())
  assignment     FirmwareAssignment?

  @@unique([targetDeviceId, version])
  @@index([targetDeviceId, createdAt])
}

model FirmwareAssignment {
  deviceId   String   @id
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  releaseId  String   @unique
  release    FirmwareRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status     String   @default("assigned")
  message    String?
  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
